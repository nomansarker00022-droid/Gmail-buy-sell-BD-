{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/send-push",
      "destination": "/index.html"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/((?!assets/|favicon.ico|robots.txt|ads.txt).*)",
      "destination": "/index.html"
    }
  ]
}
