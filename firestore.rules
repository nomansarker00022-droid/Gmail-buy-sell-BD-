rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny - Rejects everything that isn't explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins have full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Connectivity Test
    match /test/connection {
      allow read: if true;
    }

    // --- Helper Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Robust Admin Check
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email in [
          'ashrafulislambhuiyan8@gmail.com', 'nomansarker00022@gmail.com'
        ] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // System Admin (Hardcoded List)
    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'ashrafulislambhuiyan8@gmail.com', 'nomansarker00022@gmail.com'
      ];
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Helpers ---
    function isValidHeadline(data) {
      return data.text is string && data.text.size() <= 1000 &&
             data.speed is number && data.speed >= 1 && data.speed <= 200;
    }

    function isValidPricing(data) {
      return data.keys().size() <= 50; 
    }
    
    function isValidProfile(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('balance' in data) || data.balance is number) &&
             (!('earningsBalance' in data) || data.earningsBalance is number) &&
             (!('totalSales' in data) || data.totalSales is number) &&
             (!('totalOrders' in data) || data.totalOrders is number) &&
             (!('totalSpent' in data) || data.totalSpent is number) &&
             (!('totalEarned' in data) || data.totalEarned is number) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100) || data.displayName == null) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000000) || data.photoURL == null) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30) || data.phone == null) &&
             (!('bkashNumber' in data) || (data.bkashNumber is string && data.bkashNumber.size() <= 30) || data.bkashNumber == null) &&
             (!('nagadNumber' in data) || (data.nagadNumber is string && data.nagadNumber.size() <= 30) || data.nagadNumber == null) &&
             (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 100) || data.firstName == null) &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100) || data.lastName == null) &&
             (!('age' in data) || (data.age is number || data.age == null)) &&
             (!('address' in data) || (data.address is string || data.address == null)) &&
             (!('hasSeenWelcome' in data) || (data.hasSeenWelcome is bool)) &&
             (!('numericId' in data) || (data.numericId is string && data.numericId.size() <= 15)) &&
             (!('role' in data) || (data.role in ['user', 'admin'])) &&
             (!('uid' in data) || (data.uid is string)) &&
             (!('referredBy' in data) || (data.referredBy is string || data.referredBy == null)) &&
             (!('successfulReferrals' in data) || (data.successfulReferrals is number)) &&
             (!('hasTransacted' in data) || (data.hasTransacted is bool)) &&
             (!('hasDeposited' in data) || (data.hasDeposited is bool)) &&
             (!('adsWatchedToday' in data) || data.adsWatchedToday is number) &&
             (!('lastAdWatchedDate' in data) || (data.lastAdWatchedDate is string && data.lastAdWatchedDate.size() <= 20) || data.lastAdWatchedDate == null) &&
             (!('createdAt' in data) || (data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidWithdrawal(data) {
      return data.userId == request.auth.uid &&
             data.userEmail is string &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('bkashNumber' in data) || data.bkashNumber is string) &&
             (!('type' in data) || data.type is string) &&
             (data.createdAt is timestamp);
    }

    function isValidReport(data) {
      return (data.buyerId == request.auth.uid || isAdmin()) &&
             data.buyerEmail is string &&
             data.sellerId is string &&
             data.listingId is string &&
             (!('purchaseId' in data) || data.purchaseId is string) &&
             data.message is string && data.message.size() <= 2000 &&
             data.status in ['pending', 'resolved', 'dismissed'] &&
             (data.createdAt is timestamp);
    }

    function isValidListing(data) {
      return data.gmailAccount is string && data.gmailAccount.size() <= 256 &&
             data.type is string && data.type.size() <= 128 &&
             data.price is number && data.price >= 0 &&
             data.status in ['Available', 'Pending', 'Approved', 'Refunded', 'Dispute', 'SellRequest', 'Sold', 'Deleted', 'Rejected'] &&
             (!('sellerId' in data) || (data.sellerId == null || data.sellerId is string)) &&
             (!('sellerNumericId' in data) || (data.sellerNumericId == null || data.sellerNumericId is string)) &&
             (!('bkashNumber' in data) || (data.bkashNumber == null || data.bkashNumber is string)) &&
             (!('description' in data) || (data.description == null || (data.description is string && data.description.size() <= 4000))) &&
             (!('soldTo' in data) || (data.soldTo == null || data.soldTo is string)) &&
             (!('soldPrice' in data) || (data.soldPrice == null || data.soldPrice is number)) &&
             (!('paymentStatus' in data) || (data.paymentStatus == null || data.paymentStatus is string)) &&
             (!('payoutTrxId' in data) || (data.payoutTrxId == null || data.payoutTrxId is string)) &&
             (!('emailHash' in data) || (data.emailHash == null || data.emailHash is string)) &&
             (!('createdAt' in data) || (data.createdAt == null || data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt == null || data.updatedAt is timestamp));
    }

    function isValidCredential(data) {
      return data.email is string && data.email.size() <= 128 &&
             data.password is string && data.password.size() <= 128 &&
             (!('recoveryEmail' in data) || (data.recoveryEmail is string)) &&
             (!('recovery' in data) || (data.recovery is string)) &&
             (!('twoFactor' in data) || (data.twoFactor is string));
    }

    function isValidFacebookListing(data) {
      return data.category is string && data.category.size() <= 200 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.password is string && data.password.size() <= 100 &&
             data.twoFA is string && data.twoFA.size() <= 200 &&
             data.status in ['Live', 'Pending', 'Sold', 'Dispute'] &&
             (!('title' in data) || (data.title is string && data.title.size() <= 500)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             (!('price' in data) || (data.price is number)) &&
             (!('imageUrl' in data) || (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000000))) &&
             (!('isLiveMarket' in data) || (data.isLiveMarket is bool)) &&
             (!('sellerId' in data) || (data.sellerId is string)) &&
             (!('sellerEmail' in data) || (data.sellerEmail is string && data.sellerEmail.size() <= 256)) &&
             (!('soldTo' in data) || (data.soldTo == null || data.soldTo is string)) &&
             (!('soldPrice' in data) || (data.soldPrice == null || data.soldPrice is number)) &&
             (!('soldAt' in data) || (data.soldAt == null || data.soldAt is timestamp)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp));
    }

    function isValidPurchase(data) {
      return data.userId == request.auth.uid &&
             (!('userEmail' in data) || (data.userEmail is string)) &&
             data.price is number && data.price >= 0 &&
             data.listingId is string &&
             data.gmailAccount is string &&
             (!('sellerId' in data) || (data.sellerId is string)) &&
             (!('sellerBkash' in data) || (data.sellerBkash is string)) &&
             (!('description' in data) || (data.description is string)) &&
             (!('status' in data) || (data.status is string)) &&
             (!('paymentStatus' in data) || (data.paymentStatus is string)) &&
             (!('payoutTrxId' in data) || (data.payoutTrxId is string)) &&
             (!('purchasedAt' in data) || (data.purchasedAt is timestamp)) &&
             (!('credentials' in data) || (data.credentials is map || data.credentials == null));
    }

    function isValidPayment(data) {
      return data.userId == request.auth.uid &&
             data.senderNumber is string && data.senderNumber.size() <= 64 &&
             data.trxId is string && data.trxId.size() <= 128 &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['pending', 'verified', 'rejected'] &&
             (!('listingId' in data) || (data.listingId == null || data.listingId is string)) &&
             (!('userEmail' in data) || (data.userEmail == null || data.userEmail is string)) &&
             (!('itemIds' in data) || (data.itemIds == null || data.itemIds is list)) &&
             (!('itemCount' in data) || (data.itemCount == null || data.itemCount is number)) &&
             (!('method' in data) || (data.method == null || data.method is string)) &&
             (!('createdAt' in data) || (data.createdAt == null || data.createdAt is timestamp)) &&
             (!('updatedAt' in data) || (data.updatedAt == null || data.updatedAt is timestamp));
    }

    function isValidTrxRegistration(data) {
      return data.userId == request.auth.uid &&
             (!('createdAt' in data) || (data.createdAt == null || data.createdAt is timestamp));
    }

    function isValidReview(data) {
      return data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 2000 &&
             (!('photo' in data) || (data.photo is string && data.photo.size() <= 1000000)) &&
             (!('userName' in data) || data.userName is string) &&
             (!('userPhoto' in data) || data.userPhoto is string) &&
             (data.createdAt is timestamp);
    }

    function isValidNotification(data) {
      return data.toUserId is string &&
             (data.fromUserId == request.auth.uid || data.fromUserId == 'system') &&
             data.message is string && data.message.size() <= 3000 &&
             data.type in ["system", "info", "warning", "success", "error"] &&
             (!('read' in data) || (data.read is bool)) &&
             (data.createdAt is timestamp);
    }

    function isValidDirectChat(data) {
      return data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 200 &&
             data.receiverId is string &&
             data.receiverName is string && data.receiverName.size() <= 200 &&
             data.roomId is string && data.roomId.size() <= 200 &&
             (!('listingId' in data) || data.listingId is string) &&
             (!('listingTitle' in data) || (data.listingTitle is string && data.listingTitle.size() <= 200)) &&
             data.text is string && data.text.size() <= 5000 &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2000000));
    }

    // --- Collections ---

    // Registries for uniqueness
    match /used_trx_ids/{trxId} {
      allow get: if isSignedIn() && isValidId(trxId);
      allow create: if isSignedIn() && isValidTrxRegistration(incoming());
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profiles
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidProfile(incoming()) && (
        !('role' in incoming()) || incoming().role == 'user'
      ) && (
        !('balance' in incoming()) || incoming().balance == 0
      ) && (
        !('totalSpent' in incoming()) || incoming().totalSpent == 0
      ) && (
        !('totalEarned' in incoming()) || incoming().totalEarned == 0
      ) && (
        !('earningsBalance' in incoming()) || incoming().earningsBalance == 0
      ) && (
        !('totalSales' in incoming()) || incoming().totalSales == 0
      ) && (
        !('totalOrders' in incoming()) || incoming().totalOrders == 0
      ) && (
        !('successfulReferrals' in incoming()) || incoming().successfulReferrals == 0
      ) && (
        !('adsWatchedToday' in incoming()) || incoming().adsWatchedToday == 0
      );
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        // Relational Update: Buyer/Seller stats transfer during purchase (from Admin / Backend transaction)
        // We trust these specific keys because they are only updated in transactions
        (incoming().diff(existing()).affectedKeys().hasOnly([
          'totalSales', 'totalEarned', 'earningsBalance', 'updatedAt', 'balance', 'totalOrders', 
          'totalSpent', 'successfulReferrals', 'hasTransacted', 'hasDeposited'
        ])) ||
        // Owner updates own profile (Self care)
        (isOwner(userId) && isValidProfile(incoming()) && (
          // Basic fields update - Standard Users CANNOT update role, balance, or stats
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'phone', 'bkashNumber', 'nagadNumber',
            'firstName', 'lastName', 'age', 'address', 'hasSeenWelcome',
            'updatedAt', 'referredBy'
          ]) ||
          // Action: Claim ad earnings reward which increments earningsBalance, totalEarned, and sets adsWatchedToday/lastAdWatchedDate
          incoming().diff(existing()).affectedKeys().hasOnly([
            'earningsBalance', 'totalEarned', 'adsWatchedToday', 'lastAdWatchedDate'
          ])
        ))
      );
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidWithdrawal(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Listings
    match /listings/{listingId} {
      allow list: if true;
      allow get: if true; 

      allow create: if isSignedIn() && (
        (isAdmin() && isValidListing(incoming())) ||
        (!isAdmin() && isValidListing(incoming()) && incoming().status == 'SellRequest' && incoming().sellerId == request.auth.uid)
      );

      allow update: if isSignedIn() && isValidListing(incoming()) && (
        isAdmin() || 
        // Seller can update their own listing before it's sold
        (isOwner(existing().sellerId) && 
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'price', 'gmailAccount', 'type', 'description', 'bkashNumber'])) ||
        // Buyer flow: User marks it as Pending (Available -> Pending)
        (existing().status == 'Available' && 
          incoming().status == 'Pending' && 
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Buyer flow: User marks it as Sold to themselves (Available -> Sold)
        (existing().status == 'Available' && 
          incoming().status == 'Sold' && 
          incoming().soldTo == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'soldTo', 'updatedAt', 'soldPrice', 'paymentStatus']))
      );
      
      allow delete: if isAdmin();

      // Nested credentials
      match /private/credentials {
        allow get: if isSignedIn() && (
          isAdmin() ||
          isOwner(get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId) ||
          exists(/databases/$(database)/documents/purchases/$(request.auth.uid + '_' + listingId)) ||
          existsAfter(/databases/$(database)/documents/purchases/$(request.auth.uid + '_' + listingId)) ||
          get(/databases/$(database)/documents/listings/$(listingId)).data.soldTo == request.auth.uid ||
          getAfter(/databases/$(database)/documents/listings/$(listingId)).data.soldTo == request.auth.uid
        );
        allow write: if isAdmin() || (isSignedIn() && isOwner(get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId) && isValidCredential(incoming()));
      }
    }

    // Facebook Listings
    match /facebook_listings/{listingId} {
      allow list: if (resource.data.status == 'Live') || (isSignedIn() && (
        resource.data.sellerId == request.auth.uid || 
        resource.data.soldTo == request.auth.uid || 
        isAdmin()
      ));
      allow get: if (resource.data.status == 'Live') || (isSignedIn() && (
        resource.data.sellerId == request.auth.uid || 
        resource.data.soldTo == request.auth.uid || 
        isAdmin()
      ));
      allow create: if isSignedIn() && isValidFacebookListing(incoming()) && (
        isAdmin() ||
        (incoming().sellerId == request.auth.uid && incoming().status == 'Live')
      ) && (incoming().createdAt == request.time);
      allow update: if isSignedIn() && isValidFacebookListing(incoming()) && (
        isAdmin() ||
        // Action: Seller updates their listing credentials or details
        (resource.data.sellerId == request.auth.uid && 
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'phone', 'password', 'twoFA']) &&
          incoming().sellerId == existing().sellerId) ||
        // Action: Buyer/Market checkout flow
        (existing().status == 'Live' && 
          incoming().status == 'Sold' && 
          incoming().soldTo == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'soldTo', 'soldPrice', 'soldAt']) &&
          incoming().sellerId == existing().sellerId)
      );
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidPurchase(incoming()) && purchaseId == (request.auth.uid + '_' + incoming().listingId);
      allow update: if isAdmin() || (isSignedIn() && isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['credentials', 'status']));
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidPayment(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow list: if isSignedIn() && (resource.data.toUserId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.toUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.toUserId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
      );
      allow delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update, delete: if isAdmin();
    }

    // Direct Chats / Peer-to-Peer messages
    match /direct_chats/{messageId} {
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidDirectChat(incoming()) && (incoming().createdAt == request.time);
      allow update: if false; // Messages are immutable after sending
      allow delete: if isAdmin();
    }

    // Admins metadata
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; 
    }
  }
}
